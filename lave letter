<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My Love - Special Surprise</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&family=Dancing+Script:wght@700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            font-family: 'Poppins', sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
            padding: 20px;
        }
        .container {
            text-align: center;
            z-index: 10;
            max-width: 600px;
            width: 100%;
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            padding: 40px 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            border: 1px solid rgba(255, 255, 255, 0.15);
            position: relative;
        }

        /* Name Input Screen */
        .input-screen {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .input-screen h2 {
            font-family: 'Dancing Script', cursive;
            font-size: 3rem;
            color: #ff8fa3;
            margin-bottom: 10px;
        }
        .input-screen p {
            font-size: 0.95rem;
            color: #d1d1d1;
            margin-bottom: 25px;
        }
        .name-input {
            width: 85%;
            padding: 14px 20px;
            font-size: 1.1rem;
            border-radius: 50px;
            border: 2px solid rgba(255, 101, 132, 0.5);
            background: rgba(255, 255, 255, 0.1);
            color: white;
            text-align: center;
            outline: none;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }
        .name-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }
        .name-input:focus {
            border-color: #ff6584;
            box-shadow: 0 0 15px rgba(255, 101, 132, 0.5);
        }
        .btn-surprise {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            border: none;
            padding: 14px 35px;
            font-size: 1.2rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(255, 65, 108, 0.5);
        }
        .btn-surprise:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(255, 65, 108, 0.8);
        }
        .error-msg {
            color: #ff6b6b;
            font-size: 0.85rem;
            margin-top: 10px;
            display: none;
        }

        /* Main Surprise Screen (Hidden Initially) */
        .main-content {
            display: none;
            animation: fadeIn 1.2s ease-in-out forwards;
        }
        .greeting-name {
            font-family: 'Dancing Script', cursive;
            font-size: 3.5rem;
            color: #ff6584;
            margin-bottom: 5px;
            text-shadow: 0 2px 10px rgba(255, 101, 132, 0.5);
        }
        .love-text {
            font-size: 2.3rem;
            font-family: 'Dancing Script', cursive;
            color: #ff8fa3;
            margin-bottom: 15px;
            font-weight: bold;
            animation: bounce 2s infinite;
        }
        .subtitle {
            font-size: 1rem;
            letter-spacing: 2px;
            margin-bottom: 25px;
            color: #e0e0e0;
            text-transform: uppercase;
        }
        .message-box {
            background: rgba(255, 101, 132, 0.1);
            border: 1px dashed rgba(255, 101, 132, 0.4);
            padding: 20px;
            border-radius: 15px;
            font-size: 1rem;
            line-height: 1.6;
            color: #f1f1f1;
            margin-bottom: 20px;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        /* Watermark / Side text */
        .watermark {
            position: absolute;
            bottom: 12px;
            right: 18px;
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.5);
            font-style: italic;
            letter-spacing: 1px;
        }

        /* Enhanced Floating hearts animation */
        .heart {
            position: absolute;
            color: rgba(255, 101, 132, 0.8);
            font-size: 24px;
            animation: floatUpAndRotate 5s linear infinite;
            z-index: 1;
            user-select: none;
            pointer-events: none;
        }
        @keyframes floatUpAndRotate {
            0% {
                transform: translateY(105vh) scale(0.4) rotate(0deg);
                opacity: 0;
            }
            20% {
                opacity: 1;
            }
            80% {
                opacity: 1;
            }
            100% {
                transform: translateY(-10vh) scale(1.4) rotate(360deg);
                opacity: 0;
            }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <!-- Floating Hearts Container -->
    <div id="hearts-container"></div>

    <div class="container">
        <!-- Step 1: Name Input Form -->
        <div id="inputScreen" class="input-screen">
            <h2>Special Surprise</h2>
            <p>Enter your name to unlock your surprise ❤️</p>
            <input type="text" id="userNameInput" class="name-input" placeholder="Type your name here..." autocomplete="off">
            <button class="btn-surprise" onclick="checkName()">🎁 Open Surprise</button>
            <div id="errorMsg" class="error-msg">Please type your name to proceed!</div>
        </div>

        <!-- Step 2: Main Surprise Content -->
        <div id="mainContent" class="main-content">
            <h1 id="displayName" class="greeting-name"></h1>
            <div class="love-text">I Love You Asfia ❤️</div>
            <div class="subtitle">My Heart, My Life, My Everything</div>
            <div class="message-box">
                You are the most precious person in my life. Every single moment spent with you feels like pure magic. My heart beats only for you, and I promise to keep you happy always! ✨
            </div>
        </div>

        <!-- Side Love Letter Message -->
        <div class="watermark">Love letter message: Shoyaib YT</div>
    </div>

    <!-- YouTube Background Music (Autoplay) -->
    <iframe id="bgMusic" width="0" height="0" src="https://www.youtube.com/embed/UHVJ7oZUN-o?autoplay=1&loop=1&playlist=UHVJ7oZUN-o" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>

    <script>
        function checkName() {
            const inputVal = document.getElementById('userNameInput').value.trim();
            const errorMsg = document.getElementById('errorMsg');

            if (inputVal === "") {
                errorMsg.style.display = 'block';
                return;
            }

            // Set the name dynamically
            document.getElementById('displayName').innerText = inputVal;

            // Hide input screen and show main content
            document.getElementById('inputScreen').style.display = 'none';
            document.getElementById('mainContent').style.display = 'block';
            
            // Trigger heavy heart burst animation
            createHeartsBurst();
        }

        // Generate floating background hearts with multiple emojis
        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            const heartsArray = ['❤️', '💖', '💘', '💓', '💗', '💕', '✨'];
            heart.innerHTML = heartsArray[Math.floor(Math.random() * heartsArray.length)];
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = (Math.random() * 3 + 3) + 's';
            heart.style.fontSize = (Math.random() * 20 + 16) + 'px';
            document.body.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 6000);
        }

        // Continuous floating hearts
        setInterval(createHeart, 300);

        // Burst effect when opening surprise
        function createHeartsBurst() {
            for (let i = 0; i < 30; i++) {
                setTimeout(createHeart, i * 60);
            }
        }
    </script>
</body>
</html>
